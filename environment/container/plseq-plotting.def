Bootstrap: docker
From: mambaorg/micromamba:2.3.3

%labels
    org.opencontainers.image.title "PL-Seq plotting environment"
    org.opencontainers.image.description "Reproducible Python, R, and pyGenomeTracks environment for PL-Seq figures"
    org.opencontainers.image.source "https://github.com/UConnMiura/PLSeq-reanalysis"
    org.opencontainers.image.licenses "MIT"

%post
    micromamba install --yes --name base \
        --channel conda-forge --channel bioconda \
        python=3.12 \
        matplotlib=3.8.4 \
        numpy \
        scipy \
        pillow \
        pandas \
        pysam=0.24.1 \
        pygenometracks=3.9 \
        r-base \
        r-ggplot2 \
        r-dplyr \
        r-tidyr \
        pandoc \
        poppler
    micromamba clean --all --yes

%environment
    export PATH="/opt/conda/bin:${PATH}"
    export MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp/plseq-matplotlib}"
    export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/plseq-cache}"
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec "$@"

%test
    export XDG_CACHE_HOME=/tmp/plseq-cache
    mkdir -p "$XDG_CACHE_HOME"
    python3 -c 'import matplotlib, numpy, scipy, PIL, pandas, pysam; print("Python plotting imports OK")'
    pyGenomeTracks --version
    Rscript -e 'stopifnot(requireNamespace("ggplot2", quietly=TRUE), requireNamespace("dplyr", quietly=TRUE), requireNamespace("tidyr", quietly=TRUE)); cat("R plotting imports OK\n")'
    pandoc --version | head -1
    pdfinfo -v 2>&1 | head -1
